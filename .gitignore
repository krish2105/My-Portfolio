# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Local env (secrets) — keep .env.example tracked
.env
.env.*
!.env.example

# Never commit archives or large generated images
*.zip
Gemini_Generated_Image_*.png
.lighthouseci/
.vercel


# Self-hosted model weights are tracked via Git LFS (see .gitattributes). Re-include them so a
# global `*.onnx` ignore rule (easy to have in ~/.gitignore_global) can't silently drop them.
!public/models/**/*.onnx
