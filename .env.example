# ─────────────────────────────────────────────────────────────
# Contact form (Resend) — set these in your Vercel project's
# Environment Variables. They are used by the serverless function
# at /api/contact and are NEVER exposed to the browser.
# Sign up at https://resend.com and create an API key.
# ─────────────────────────────────────────────────────────────

# Required for the contact form to actually send email:
RESEND_API_KEY=

# Optional overrides:
# Where contact messages are delivered (defaults to krishnamathur008@gmail.com):
CONTACT_TO_EMAIL=
# A verified Resend sender. Until you verify a domain in Resend, leave this
# blank to use Resend's shared onboarding sender. Example once verified:
#   CONTACT_FROM_EMAIL=Portfolio <hello@yourdomain.com>
CONTACT_FROM_EMAIL=

# ─────────────────────────────────────────────────────────────
# Portfolio Copilot AI (Google Gemini)
# Optional: Enables live generative real-time AI responses in the
# portfolio assistant for open-ended recruiter inquiries.
# Get a key at: https://aistudio.google.com/app/apikey
# ─────────────────────────────────────────────────────────────
VITE_GEMINI_API_KEY=

# Optional: override the Gemini model. Google retires models on a schedule (1.5 and 2.0
# are already gone and return 404) — check https://ai.google.dev/gemini-api/docs/deprecations.
# Defaults to gemini-3.8-flash when unset.
# VITE_GEMINI_MODEL=

# NOTE: any VITE_* variable is inlined into the public JS bundle, so VITE_GEMINI_API_KEY is
# visible to every visitor. Only use a key that is HTTP-referrer-restricted to your domain
# and quota-capped in Google AI Studio / Cloud Console.
